# Copy this file to `.env` and fill in your own values. NEVER commit a real .env.

# ── Required: LLM access (OpenRouter, OpenAI-compatible) ──
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=<your-openrouter-api-key>

# ── Optional: Hugging Face (only to download a private dataset repo or push data) ──
HF_ENDPOINT=https://huggingface.co
HF_API_KEY=<your-huggingface-token>

# ── Optional: market-data sources for the data-preparation pipeline ──
# Binance public klines need no key. The other backends are only used if you
# fetch from them; leave blank otherwise.
# FMP_API_KEY=
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# TUSHARE_API_KEY=
